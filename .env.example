# Server-side Meta Model API key. Never expose this with a NEXT_PUBLIC_ prefix.
MODEL_API_KEY=

# Muse Spark Standard mode is used for chat, adviser responses, and triage.
META_TEXT_MODEL=muse-spark-1.3
# Setup-copilot model for controlled synthetic evaluations only.
# Server-only allowlist: muse-spark-1.3 or muse-wonder-1.0. Defaults to Spark; no runtime fallback.
META_SETUP_MODEL=muse-spark-1.3

# Optional shared rate-limit backend (Upstash Redis REST). When unset, the
# single-instance process-memory limiter is used instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase backend (assumed provisioned for Phases 4-6). The service-role key
# is server-only and must never use a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional shared secret for manually invoking the moderation queue worker.
# Vercel Cron uses CRON_SECRET and sends it as a Bearer authorization header.
MODERATION_WORKER_SECRET=
CRON_SECRET=
# Experimental facilitator remains disabled until its bot identity and consent flow are verified.
COMMUNITY_FACILITATOR_ENABLED=false

# Comma-separated Supabase user UUIDs allowed to approve community launch and
# explicitly confirm that human moderation coverage is arranged.
COMMUNITY_REVIEWER_USER_IDS=

# Operational controls (Phase 8).
# Shared secret for GET /api/ops/metrics (x-ops-secret header).
OPS_METRICS_SECRET=
# Set to 1 to fail model-backed routes closed without calling Meta.
HARMONISE_KILL_SWITCH=0
# Daily per-user cap on model-backed calls when signed in.
DAILY_MODEL_CALLS_PER_USER=100

# Set to true to show community-scoped, human-reviewed role verification.
# Contribution levels are activity recognition and never grant verified roles.
COMMUNITY_ROLE_VERIFICATION_ENABLED=false
