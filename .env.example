# Server-side Meta Model API key. Never expose this with a NEXT_PUBLIC_ prefix.
MODEL_API_KEY=

# Muse Spark Standard mode is used for chat, adviser responses, and triage.
META_TEXT_MODEL=muse-spark-1.3

# Optional shared rate-limit backend (Upstash Redis REST). When unset, the
# single-instance process-memory limiter is used instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase backend (assumed provisioned for Phases 4-6). The service-role key
# is server-only and must never use a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
